# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME="QC Backend"
PORT=3000
API_PREFIX=api/v1
# Comma separated allowed origins. Leave empty to allow all (development only).
CORS_ORIGINS=
# IANA timezone used for "today" (OTP daily window, expiry sweeps, store default).
DEFAULT_TIMEZONE=Asia/Dhaka

# ─────────────────────────────────────────────────────────────────────────────
# Languages (no database table; every translatable field must contain DEFAULT_LANGUAGE)
# ─────────────────────────────────────────────────────────────────────────────
LANGUAGES=en,bn
DEFAULT_LANGUAGE=en

# ─────────────────────────────────────────────────────────────────────────────
# Currency (returned with every price: amount + code + symbol)
# ─────────────────────────────────────────────────────────────────────────────
DEFAULT_CURRENCY=BDT
# Optional override. Derived from DEFAULT_CURRENCY when empty (INR -> ₹).
CURRENCY_SYMBOL=

# ─────────────────────────────────────────────────────────────────────────────
# Database / Redis
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/qc
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────────────
# Phone numbers (strict E.164, e.g. +919876543210)
# ─────────────────────────────────────────────────────────────────────────────
# ISO 3166-1 alpha-2 country codes whose numbers are accepted.
PHONE_ALLOWED_COUNTRIES=BD

# ─────────────────────────────────────────────────────────────────────────────
# OTP
# ─────────────────────────────────────────────────────────────────────────────
# Secrets must be >= 32 characters in production.
OTP_HMAC_SECRET=change-me-change-me-change-me-1234
OTP_TTL_SEC=300
OTP_MAX_PER_DAY=7
OTP_BASE_COOLDOWN_SEC=30
OTP_MAX_COOLDOWN_SEC=1800
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_VERIFY_LOCK_SCHEDULE_SEC=0,0,30,120,600,1800
# Consecutive days of hitting the daily limit before a permanent block.
OTP_BLOCK_AFTER_FAILED_DAYS=2
# Returns the OTP in the response. Refused when NODE_ENV=production.
OTP_DEV_ECHO=true

# ─────────────────────────────────────────────────────────────────────────────
# Password login (admin / store manager)
# ─────────────────────────────────────────────────────────────────────────────
PASSWORD_MAX_FAILURES=5
PASSWORD_LOCK_MINUTES=15

# ─────────────────────────────────────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-change-me-change-me-5678
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_CHALLENGE_SECRET=change-me-change-me-change-me-9012
JWT_CHALLENGE_TTL=10m

# ─────────────────────────────────────────────────────────────────────────────
# Cache (seconds) and lease (single-flight) tuning
# ─────────────────────────────────────────────────────────────────────────────
CACHE_CATALOG_TTL_SEC=600
CACHE_PRODUCT_TTL_SEC=300
CACHE_PERMISSIONS_TTL_SEC=300
CACHE_ACCOUNT_TTL_SEC=60
CACHE_STORE_GEO_TTL_SEC=300
CACHE_LEASE_MS=5000
CACHE_LEASE_POLL_MS=50
CACHE_LEASE_MAX_POLLS=60

# ─────────────────────────────────────────────────────────────────────────────
# Media (LOCAL serves ./uploads/public at /static; point the base URL at a CDN later)
# ─────────────────────────────────────────────────────────────────────────────
MEDIA_PROVIDER=LOCAL
MEDIA_LOCAL_DIR=./uploads
MEDIA_PUBLIC_DIR=public
MEDIA_PUBLIC_BASE_URL=http://localhost:3000/media-public
MEDIA_BUCKET=
MEDIA_MAX_BYTES=10485760

# ─────────────────────────────────────────────────────────────────────────────
# Payments
# ─────────────────────────────────────────────────────────────────────────────
PAYMENT_GATEWAY=razorpay
PAYMENT_WEBHOOK_SECRET=change-me

# ─────────────────────────────────────────────────────────────────────────────
# Cart
# ─────────────────────────────────────────────────────────────────────────────
GUEST_CART_TTL_HOURS=72
USER_CART_TTL_DAYS=30
GUEST_CARTS_PER_IP_PER_HOUR=20

# ─────────────────────────────────────────────────────────────────────────────
# Orders / delivery
# ─────────────────────────────────────────────────────────────────────────────
ORDER_COD_MAX_AMOUNT=5000
ORDER_PAYMENT_WINDOW_MIN=15
ORDER_ETA_BUFFER_MIN=15
DELIVERY_EARNING=30
DELIVERY_MAX_ACTIVE_ORDERS=2

# ─────────────────────────────────────────────────────────────────────────────
# Inventory
# ─────────────────────────────────────────────────────────────────────────────
INVENTORY_LOW_STOCK_DEFAULT=5
INVENTORY_EXPIRING_MAX_DAYS=90
INVENTORY_EXPIRING_DEFAULT_DAYS=7
INVENTORY_EXPIRING_LIMIT=200
INVENTORY_RECEIVE_TX_TIMEOUT_MS=20000
INVENTORY_SWEEP_LOCK_TTL_SEC=600
INVENTORY_SWEEP_BATCH_SIZE=500
