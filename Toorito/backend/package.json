{
  "name": "qc-backend",
  "version": "0.1.0",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.json",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts",
    "test:db:up": "docker compose up -d --wait db-test redis-test",
    "test:db:down": "docker compose stop db-test redis-test",
    "test": "jest --config test/jest.config.js --selectProjects unit",
    "test:watch": "jest --config test/jest.config.js --selectProjects unit --watch",
    "test:e2e": "npm run test:db:up && jest --config test/jest.config.js --selectProjects e2e --runInBand",
    "test:all": "npm run test:db:up && jest --config test/jest.config.js --runInBand",
    "test:cov": "jest --config test/jest.config.js --selectProjects unit --coverage",
    "docs:swagger": "npm run build && node scripts/generate-api-docs.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.2.0",
    "@nestjs/websockets": "^11.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.40.3",
    "bullmq": "^5.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "libphonenumber-js": "^1.13.13",
    "ms": "^2.1.3",
    "nestjs-i18n": "^10.8.5",
    "openapi-markdown": "^1.2.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.7.5",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@types/jest": "^29.5.14",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.20.4",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^6.0.3",
    "dotenv": "^18.0.5",
    "jest": "^29.7.0",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.5",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "^5.4.1"
    },
	"multer": "^2.5.0"
  }
}
